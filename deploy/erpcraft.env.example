# Settings of an erpcraft installation. Copy to deploy/erpcraft.env and keep
# it out of version control: it holds secrets. Pass it to docker compose
# with --env-file (for the database) and it is read by the server too.

# The database. Choose a long random password once: PostgreSQL takes it
# when its volume is first created.
POSTGRES_USER=erpcraft
POSTGRES_PASSWORD=
POSTGRES_DB=erpcraft

# The first administrator, created when there are no users yet. Change the
# password after the first sign-in, then remove these two lines.
ERPCRAFT_ADMIN_EMAIL=admin@example.com
ERPCRAFT_ADMIN_PASSWORD=

# The address users reach erpcraft at, through the reverse proxy.
ERPCRAFT_PUBLIC_URL=https://erp.example.com
# Pages allowed to call the MCP endpoint, separated by commas.
ERPCRAFT_MCP_ALLOWED_ORIGINS=https://erp.example.com

# Log level: error, warn, info, debug.
RUST_LOG=info

# The image to run, and where its port is published (keep it on loopback
# behind the proxy).
# ERPCRAFT_IMAGE=erpcraft:latest
# ERPCRAFT_PUBLISH=127.0.0.1:8600
