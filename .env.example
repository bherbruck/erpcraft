DATABASE_URL=postgres://erpcraft:erpcraft@127.0.0.1:54320/erpcraft
ERPCRAFT_BIND=127.0.0.1:8600
# Creates the first administrator when the user table is empty.
ERPCRAFT_ADMIN_EMAIL=admin@example.com
ERPCRAFT_ADMIN_PASSWORD=change-me-now
# Serve the admin UI from this directory of built files (cd ui && bun run build).
# ERPCRAFT_UI_DIR=ui/dist
# The address users reach the server at. Needed for single sign-on: the
# redirect URI registered with a provider is <this>/api/auth/sso/<slug>/callback.
# ERPCRAFT_PUBLIC_URL=https://erp.example.com
# Development only: accept an identity provider on this machine over plain http.
# ERPCRAFT_SSO_ALLOW_INSECURE=1
# The web origins whose pages may call the MCP endpoint, separated by commas.
# Unset: pages served by this server itself and pages on this machine.
# ERPCRAFT_MCP_ALLOWED_ORIGINS=https://erp.example.com
