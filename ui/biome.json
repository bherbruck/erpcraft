{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      "**",
      "!dist",
      "!node_modules",
      "!src/api/generated.ts",
      "!docs",
      "!e2e-failures",
      "!src/components/ui",
      "!src/hooks/use-mobile.ts",
      "!src/lib/utils.ts",
      "!components.json"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "css": {
    "parser": { "tailwindDirectives": true }
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error",
        "noTsIgnore": "error"
      },
      "style": {
        "noNonNullAssertion": "error",
        "useNumberNamespace": "off",
        "noRestrictedGlobals": {
          "level": "error",
          "options": {
            "deniedGlobals": {
              "fetch": "Only src/api/client.ts talks to the server. Use `api` from there.",
              "parseFloat": "Amounts and quantities are decimal strings and are never parsed into a number. See src/lib/decimal.ts.",
              "XMLHttpRequest": "Only src/api/client.ts talks to the server. Use `api` from there."
            }
          }
        },
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["@radix-ui/*", "radix-ui", "radix-ui/*", "cmdk", "react-day-picker"],
                "message": "Use the shared components in src/components. They carry the rules of GUIDELINES.md (a dialog that does not close on an outside click, a lookup that searches on the server)."
              },
              {
                "group": ["@/components/ui/dialog", "@/components/ui/alert-dialog", "@/components/ui/button"],
                "message": "Use Dialog from @/components/dialog (closes only through its own buttons) and Button from @/components/button (type=button by default, shows progress while busy)."
              }
            ]
          }
        },
        "noJsxLiterals": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/api/client.ts", "scripts/**"],
      "linter": { "rules": { "style": { "noRestrictedGlobals": "off" } } }
    },
    {
      "includes": ["src/components/**"],
      "linter": { "rules": { "style": { "noRestrictedImports": "off" } } }
    },
    {
      "includes": ["scripts/**", "**/*.test.ts", "vite.config.ts"],
      "linter": { "rules": { "style": { "noJsxLiterals": "off" } } }
    }
  ]
}
