{
  "name": "erpcraft-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "generate": "bun scripts/generate-api-types.ts",
    "seed": "bun scripts/seed.ts",
    "screenshots": "bun scripts/screenshots.ts",
    "e2e": "bun scripts/e2e.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "bun test src",
    "check": "tsc --noEmit && biome check . && bun test src",
    "check:dist": "bun scripts/check-dist.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.73.0",
    "react": "19",
    "react-dom": "19",
    "react-router": "7",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@tailwindcss/vite": "^4.3.5",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
